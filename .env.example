# === API / Backend ===
NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/educa_lambayeque?schema=public"

# JWT (cambiar en produccion con valores aleatorios de 64+ chars)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-en-produccion
JWT_REFRESH_SECRET=cambia-esto-por-otro-secreto-largo-y-aleatorio-en-produccion
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

# CORS: dominios permitidos separados por coma
CORS_ORIGINS=http://localhost:5173,https://localhost

# Bcrypt
BCRYPT_ROUNDS=10

# === Admin / Frontend ===
# API para el entorno web local
VITE_API_URL=http://localhost:3000/api

# Modo Android: true solo al compilar el contenido para el APK
VITE_APP_MOBILE=false

# URL HTTPS directa al APK publicado. Dejar vacía hasta publicarlo.
VITE_APK_DOWNLOAD_URL=
