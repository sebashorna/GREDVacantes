// Schema Prisma - Educa Lambayeque (GRED Lambayeque)
//
// PROVISIONAL: el modelo refleja las 4 pantallas Stitch. Los catalogos
// (UGEL / Provincia / Distrito) se consideran estables; los datos de las
// tablas de negocio son de muestra y estan marcados como tal en el seed.
//
// Cuando se confirme la base de datos oficial, se ajustan los campos y se
// genera una migracion nueva (las migraciones Prisma son encadenadas, por
// lo que el historial se conserva).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * ==================================================================
 */
/**
 * Enums
 */
/**
 * ==================================================================
 */

enum NivelEducativo {
  INICIAL_JARDIN
  PRIMARIA
  SECUNDARIA
  EBE
}

enum Turno {
  MANANA
  TARDE
  MANANA_Y_TARDE
  COMPLETO
  CONTINUO_DIURNO
}

enum Zona {
  URBANA
  RURAL_1
  RURAL_2
  RURAL_3_EIB
}

enum Jornada {
  JORNADA_30
  JORNADA_35
  JORNADA_40
  JORNADA_25
}

enum EstadoVacante {
  LIBRE
  COMPLETO
  LISTA_ESPERA
  CERRADO
}

enum TipoPlaza {
  ORGANICA
  EVENTUAL_CUADRO
  REEMPLAZO_LICENCIA
  POR_EVALUACION
}

enum EstadoPlaza {
  ACTIVA
  ADJUDICADA
  CERRADA
  CONVOCADA
}

enum FaseConvocatoria {
  INSCRIPCION
  ADJUDICACION
  CONTRATACION
  FINALIZADA
}

enum EstadoLocal {
  OPTIMO
  MANTENIMIENTO_PREVENTIVO
  EN_REFRACCION
  AULAS_TEMPORALES
  ATENCION_PRIORITARIA
  OPERATIVO_REGULAR
}

enum EstadoServicio {
  AGUA_24H
  CISTERNA
  RED_OK
  NO_DISPONIBLE
}

enum EstadoAlerta {
  ABIERTA
  EN_ATENCION
  RESUELTA
  DESCARTADA
}

enum TipoAlerta {
  FILTRACION
  AULA_DETERIORADA
  FALTA_AGUA
  FALTA_LUZ
  OTRO
}

enum CategoriaComunicado {
  MATERIALES
  CAPACITACION
  CONVOCATORIA
  NORMATIVA
  SERVICIO
}

enum Rol {
  ADMIN_GRED
  EDITOR_UGEL
  CONSULTOR
}

model Ugel {
  id            Int                    @id @default(autoincrement())
  codigo        String                 @unique @db.VarChar(20)
  nombre        String                 @db.VarChar(150)
  instituciones InstitucionEducativa[]
  usuarios      Usuario[]
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  @@map("ugel")
}

model Provincia {
  id            Int                    @id @default(autoincrement())
  codigo        String                 @unique @db.VarChar(20)
  nombre        String                 @db.VarChar(100)
  distritos     Distrito[]
  instituciones InstitucionEducativa[]
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  @@map("provincia")
}

model Distrito {
  id            Int                    @id @default(autoincrement())
  codigo        String                 @unique @db.VarChar(20)
  nombre        String                 @db.VarChar(100)
  provinciaId   Int                    @map("provincia_id")
  provincia     Provincia              @relation(fields: [provinciaId], references: [id], onDelete: Restrict)
  instituciones InstitucionEducativa[]
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  @@index([provinciaId])
  @@map("distrito")
}

/**
 * ==================================================================
 */
/**
 * Institucion educativa
 */
/**
 * ==================================================================
 */

model InstitucionEducativa {
  id            Int            @id @default(autoincrement())
  codigoModular String         @unique @map("codigo_modular") @db.VarChar(10)
  nombre        String         @db.VarChar(200)
  nivel         NivelEducativo
  turno         Turno
  zona          Zona
  ugelId        Int            @map("ugel_id")
  ugel          Ugel           @relation(fields: [ugelId], references: [id], onDelete: Restrict)
  provinciaId   Int            @map("provincia_id")
  provincia     Provincia      @relation(fields: [provinciaId], references: [id], onDelete: Restrict)
  distritoId    Int            @map("distrito_id")
  distrito      Distrito       @relation(fields: [distritoId], references: [id], onDelete: Restrict)
  telefono      String?        @db.VarChar(20)
  whatsapp      String?        @db.VarChar(20)
  activo        Boolean        @default(true)

  vacantes VacanteMatricula[]
  plazas   PlazaDocente[]
  locales  LocalEscolar[]
  alertas  AlertaCiudadana[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([nivel])
  @@index([ugelId])
  @@index([distritoId])
  @@index([nombre])
  @@map("institucion_educativa")
}

/**
 * ==================================================================
 */
/**
 * Matricula: vacantes
 */
/**
 * ==================================================================
 */

model VacanteMatricula {
  id              Int                  @id @default(autoincrement())
  ieId            Int                  @map("ie_id")
  ie              InstitucionEducativa @relation(fields: [ieId], references: [id], onDelete: Cascade)
  nivel           NivelEducativo
  turno           Turno
  cupoTotal       Int                  @map("cupo_total")
  cupoDisponibles Int                  @map("cupo_disponibles")
  estado          EstadoVacante        @default(LIBRE)
  fechaLimite     DateTime?            @map("fecha_limite") @db.Date
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  @@index([ieId])
  @@index([nivel])
  @@index([estado])
  @@map("vacante_matricula")
}

/**
 * ==================================================================
 */
/**
 * Plazas docentes
 */
/**
 * ==================================================================
 */

model Convocatoria {
  id            Int              @id @default(autoincrement())
  titulo        String           @db.VarChar(200)
  numeroRD      String           @unique @map("numero_rd") @db.VarChar(50)
  descripcion   String?          @db.Text
  fechaInicio   DateTime         @map("fecha_inicio") @db.Date
  fechaFin      DateTime         @map("fecha_fin") @db.Date
  fase          FaseConvocatoria @default(INSCRIPCION)
  pdfMeritosUrl String?          @map("pdf_meritos_url") @db.VarChar(500)
  activo        Boolean          @default(true)
  plazas        PlazaDocente[]
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@index([fase])
  @@map("convocatoria")
}

model PlazaDocente {
  id             Int                  @id @default(autoincrement())
  ieId           Int                  @map("ie_id")
  ie             InstitucionEducativa @relation(fields: [ieId], references: [id], onDelete: Cascade)
  convocatoriaId Int                  @map("convocatoria_id")
  convocatoria   Convocatoria         @relation(fields: [convocatoriaId], references: [id], onDelete: Cascade)
  cargo          String               @db.VarChar(150)
  area           String               @db.VarChar(150)
  nivel          NivelEducativo
  jornada        Jornada
  zona           Zona
  turno          Turno
  tipo           TipoPlaza
  cantidad       Int                  @default(1)
  estado         EstadoPlaza          @default(ACTIVA)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([ieId])
  @@index([convocatoriaId])
  @@index([tipo])
  @@index([nivel])
  @@index([estado])
  @@map("plaza_docente")
}

/**
 * ==================================================================
 */
/**
 * Infraestructura
 */
/**
 * ==================================================================
 */

model LocalEscolar {
  id               Int                  @id @default(autoincrement())
  ieId             Int                  @map("ie_id")
  ie               InstitucionEducativa @relation(fields: [ieId], references: [id], onDelete: Cascade)
  codigoLocal      String               @unique @map("codigo_local") @db.VarChar(10)
  estado           EstadoLocal
  aulasOperativas  Int                  @map("aulas_operativas")
  aulasTotales     Int                  @map("aulas_totales")
  agua             EstadoServicio       @default(NO_DISPONIBLE)
  luz              Boolean              @default(false)
  fibra            Boolean              @default(false)
  capacidadAlumnos Int?                 @map("capacidad_alumnos")
  avanceObras      Decimal?             @map("avance_obras") @db.Decimal(5, 2)
  presupuesto      Decimal?             @db.Decimal(12, 2)
  fichaEdanUrl     String?              @map("ficha_edan_url") @db.VarChar(500)
  ultimaInspeccion DateTime?            @map("ultima_inspeccion") @db.Date
  alertas          AlertaCiudadana[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([ieId])
  @@index([estado])
  @@map("local_escolar")
}

/**
 * ==================================================================
 */
/**
 * Alertas ciudadanas
 */
/**
 * ==================================================================
 */

model AlertaCiudadana {
  id              Int                  @id @default(autoincrement())
  localEscolarId  Int                  @map("local_escolar_id")
  localEscolar    LocalEscolar         @relation(fields: [localEscolarId], references: [id], onDelete: Cascade)
  ieId            Int                  @map("ie_id")
  ie              InstitucionEducativa @relation(fields: [ieId], references: [id], onDelete: Cascade)
  tipo            TipoAlerta
  descripcion     String               @db.Text
  fotos           String[]             @default([])
  reportadoPor    String               @map("reportado_por") @db.VarChar(150)
  telefonoReporte String?              @map("telefono_reporte") @db.VarChar(20)
  estado          EstadoAlerta         @default(ABIERTA)
  observacion     String?              @db.Text
  resueltoEn      DateTime?            @map("resuelto_en")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([estado])
  @@index([tipo])
  @@index([ieId])
  @@map("alerta_ciudadana")
}

/**
 * ==================================================================
 */
/**
 * Comunicados
 */
/**
 * ==================================================================
 */

model Comunicado {
  id        String              @id @default(cuid())
  titulo    String              @db.VarChar(200)
  categoria CategoriaComunicado
  resumen   String              @db.VarChar(500)
  contenido String?             @db.Text
  fecha     DateTime            @db.Date
  imagenUrl String?             @map("imagen_url") @db.VarChar(500)
  publicado Boolean             @default(false)
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  @@index([categoria])
  @@index([publicado])
  @@index([fecha])
  @@map("comunicado")
}

/**
 * ==================================================================
 */
/**
 * Plataforma: usuarios, sesiones, auditoria
 */
/**
 * ==================================================================
 */

model Usuario {
  id            Int            @id @default(autoincrement())
  nombre        String         @db.VarChar(150)
  email         String         @unique @db.VarChar(180)
  passwordHash  String         @map("password_hash") @db.VarChar(255)
  rol           Rol            @default(CONSULTOR)
  ugelId        Int?           @map("ugel_id")
  ugel          Ugel?          @relation(fields: [ugelId], references: [id], onDelete: SetNull)
  activo        Boolean        @default(true)
  ultimoAcceso  DateTime?      @map("ultimo_acceso")
  refreshTokens RefreshToken[]
  auditorias    Auditoria[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@index([rol])
  @@map("usuario")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @map("usuario_id")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  expiraEn  DateTime @map("expira_en")
  revocado  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([usuarioId])
  @@index([expiraEn])
  @@map("refresh_token")
}

/// Bitacora de auditoria: toda operacion de escritura queda registrada.
model Auditoria {
  id        Int      @id @default(autoincrement())
  usuarioId Int?     @map("usuario_id")
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  accion    String   @db.VarChar(60)
  entidad   String   @db.VarChar(60)
  entidadId String?  @map("entidad_id") @db.VarChar(60)
  detalle   String?  @db.Text
  ip        String?  @db.VarChar(60)
  userAgent String?  @map("user_agent") @db.VarChar(300)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([usuarioId])
  @@index([entidad])
  @@index([createdAt])
  @@map("auditoria")
}
