# Entorno web local. En builds Android, VITE_API_URL debe ser una URL HTTPS
# accesible desde el teléfono y apuntar al prefijo /api.
VITE_API_URL=http://localhost:3000/api

# Cambiar a true solo al generar los recursos para el APK Android.
VITE_APP_MOBILE=false

# URL HTTPS directa del APK publicado. Déjala vacía mientras no esté disponible.
VITE_APK_DOWNLOAD_URL=
